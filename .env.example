# ══════════════════════════════════════════════════════════════
#  Data Analizer Ops — template de entorno
#  Copiar a .env y completar. El .env va gitignoreado.
#  Todo el manejo de fechas es UTC (Greenwich). No hay timezone acá.
#
#  Ops VIGILA y ESPEJA: sincroniza raw y bronze del bucket, vigila
#  la llegada de parquets (log en Firestore) y mira la facturación.
# ══════════════════════════════════════════════════════════════

# ─── AWS / S3 (lectura de raw y bronze) ───────────────────────
# Usuario IAM de solo lectura. Para la capa RAW y para la facturación
# necesita permisos extra (ver README).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET=ingest-bucket-1985
# Prefijo de bronze (mismo nombre de variable que la ETL: el .env se
# comparte por copia).
S3_PREFIX=bronze/v=1/
# Prefijo de raw. Si el pipeline lo escribe en otro lado, ajustar acá.
S3_RAW_PREFIX=raw/v=1/

# Clave de partición por fecha (Hive): dt=YYYY-MM-DD -> "dt"
S3_DATE_PARTITION_KEY=dt

# Registro de contratos, espejado junto con bronze.
S3_SCHEMA_PREFIX=schemas/

# ─── Dónde viven los espejos en disco ─────────────────────────
# Con las dos vacías, cuelgan de la carpeta compartida:
#   <Escritorio>/data-analizer-data/
#     ├── raw-local-cache/       (RAW_CACHE_DIR)
#     └── bronze-local-cache/    (CACHE_DIR — el MISMO espejo que usa la ETL)
CACHE_DIR=
RAW_CACHE_DIR=

# ─── Ventana de sincronización ────────────────────────────────
SYNC_START_DATE=2026-07-30
SYNC_CONCURRENCY=8

# ─── Semáforo del ingestor ────────────────────────────────────
# Probe TCP cada 5 minutos: conectar = instancia levantada y escuchando.
# Vacíos = la EC2 del ingest en su puerto actual. Cuando el ingest pase
# detrás de Caddy con dominio, se ajusta acá.
INGEST_HOST=
INGEST_PORT=

# ─── Firebase (cuenta de servicio del Admin SDK) ──────────────
# Firestore: marcas de sync y el log del pipeline (pipeline_log).
# Realtime Database: la vista Vivo (/activeSessions).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@TU-PROYECTO.iam.gserviceaccount.com
# En una línea, entre comillas, con los saltos de línea como \n:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=
