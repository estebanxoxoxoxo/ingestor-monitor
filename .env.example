# ══════════════════════════════════════════════════════════════
#  Ingestor Monitor — template de entorno
#  Copiar a .env y completar. El .env va gitignoreado.
#  Todo el manejo de fechas es UTC (Greenwich). No hay timezone acá.
#
#  UNA SOLA CREDENCIAL: la service account de Firebase firma Firestore
#  (el índice), la Realtime Database (Vivo) y el lake en Cloud Storage
#  (el viewer y el Full sync). Nada más es obligatorio.
# ══════════════════════════════════════════════════════════════

# ─── Firebase (cuenta de servicio del Admin SDK) — OBLIGATORIO ─
# Firebase Console → Configuración del proyecto → Cuentas de servicio
# → Generar nueva clave privada.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@TU-PROYECTO.iam.gserviceaccount.com
# En una línea, entre comillas, con los saltos de línea como \n:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Vacío = https://<proyecto>-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# ─── Lake (Cloud Storage) — opcional, con defaults ─────────────
# Vacío = <proyecto>-lake. El resto son los prefijos estándar.
LAKE_BUCKET=
LAKE_RAW_PREFIX=
LAKE_BRONZE_PREFIX=
LAKE_DATE_PARTITION_KEY=
LAKE_SCHEMA_PREFIX=

# ─── DuckDB (el viewer de archivos) — opcional ─────────────────
# Se instala con: winget install DuckDB.cli
# Vacío = se busca solo. Lee archivos ya bajados en memoria: no
# necesita internet ni credenciales.
DUCKDB_PATH=

# ─── Semáforo del ingestor — opcional ──────────────────────────
# Probe TCP cada 5 minutos: conectar = instancia levantada y escuchando.
# Vacíos = el ingest detrás de Caddy en el dominio, puerto 443.
INGEST_HOST=
INGEST_PORT=
