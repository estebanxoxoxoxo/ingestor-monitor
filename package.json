{
  "name": "ingestor-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Ingestor Monitor: el monitor de escritorio del pipeline — pestañas en vivo, índice del lake en Firestore con viewer de archivos directo del bucket, y guardia del ingestor (semáforo y uso de Firebase/GC). La transformación vive en BigQuery",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "setup": "corepack enable pnpm && pnpm install && winget install -e --id DuckDB.cli --no-upgrade --accept-source-agreements --accept-package-agreements",
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predist": "install-electron",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@firebase/app": "^0.15.0",
    "@google-cloud/storage": "^7.21.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.4",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  }
}
