data-analizer-cache/
*.parquet

# ── Logs y temporales ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
coverage/
.cache/
tmp/

# ── Editor y SO ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

