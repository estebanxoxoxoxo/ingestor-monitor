# ── Secretos ──────────────────────────────────────────────────
# El .env tiene claves de AWS y la private key del service account.
.env
.env.*
!.env.example
firebase-service-account*.json
*-service-account*.json
*.pem
*.key

# ── Dependencias ──────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build ─────────────────────────────────────────────────────
dist/
dist-electron/
out/
release/
.vite/
*.tsbuildinfo

# ── Caché de datos ────────────────────────────────────────────
